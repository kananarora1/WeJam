<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is dark-only, so the same themes apply whatever the OS dark-mode setting is. -->

    <!-- Shown while the process starts; removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Window color behind the Flutter UI while it initialises and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
