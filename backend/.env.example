# Copy to backend/.env (gitignored) and fill in. Plain KEY=value — no quotes, no "export".
# Loaded by Spring (spring.config.import in application.properties); real OS env vars override these.
# JAVA_HOME can't live here (Maven needs it before Java starts) — set it in ~/.zshrc.

# Required. Generate with: openssl rand -base64 48
JWT_SECRET=

# true = accept fake "fake:<uid>[:<phone>]" tokens (curl testing); false = real Firebase
WEJAM_AUTH_FAKE_FIREBASE=false

# Real Firebase mode
FIREBASE_PROJECT_ID=wejam-dev
GOOGLE_APPLICATION_CREDENTIALS=~/.config/wejam/firebase-sa.json

# Comma-separated E.164 numbers that are platform admins
WEJAM_ADMIN_PHONES=+911234567890

# Defaults match infra/docker-compose.yml; uncomment to override
#DB_URL=jdbc:postgresql://localhost:5433/wejam
#DB_USER=wejam
#DB_PASSWORD=wejam
#REDIS_HOST=localhost
#REDIS_PORT=6379

# Object storage (MinIO locally — defaults match infra/docker-compose.yml)
STORAGE_ENDPOINT=http://localhost:9000
# What your phone can reach; signed into upload/download URLs. Your Mac's Wi-Fi IP: ipconfig getifaddr en0
STORAGE_PUBLIC_ENDPOINT=http://192.168.1.9:9000
#STORAGE_ACCESS_KEY=wejam
#STORAGE_SECRET_KEY=wejam-dev-secret
